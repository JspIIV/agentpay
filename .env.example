# AgentPay — Arc Mainnet (chain 5042)
VITE_AGENTPAY_ADDRESS=0x

# Block the contract was deployed in. The Activity screen starts its log scan
# here; without it the scan starts at block 0 and never finishes.
VITE_AGENTPAY_DEPLOY_BLOCK=0

# x402 server: where redeemed callIds are recorded so a restart cannot
# un-redeem a payment.
CALLID_STORE_PATH=.callid-store.json
